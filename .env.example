# --- Required ---

# Your Respan API key. Respan is OpenAI-compatible; this key authenticates
# every gateway call. Find it in your Respan workspace settings.
RESPAN_API_KEY=

# The model id to run, as enabled on your Respan account (e.g. "gpt-4o-mini",
# "claude-haiku-4-5", etc). Runs fail if this model is not enabled or the
# account has no credits — that is an account setup issue, not a code bug.
RESPAN_MODEL=

# --- Optional ---

# Shared customer_identifier attached to every request, so all calls from this
# app group together in Respan. Defaults to "promptarena".
RESPAN_CUSTOMER_ID=promptarena

# Blended price per 1K tokens, used ONLY for the rough pre-run cost estimate and
# the post-run actual-cost figure. Set it to match your model. Defaults to 0.005.
RESPAN_PRICE_PER_1K_TOKENS=0.005

# Optional: base URL for the Respan management API (prompt promotion via the
# @respan/respan-api SDK). Leave unset to use the SDK default (https://api.respan.ai).
# RESPAN_API_BASE_URL=

# Optional: path to the local run-history SQLite file (Node's built-in node:sqlite).
# Defaults to ./.data/promptarena.db.
# PROMPTARENA_DB=

# Optional: base URL of the Respan dashboard for "view in Respan" deep links
RESPAN_DASHBOARD_URL=https://app.respan.ai
